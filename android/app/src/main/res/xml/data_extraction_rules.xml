<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing this app stores may leave the device.

    The caches hold HP Jira issues and TestRail cases, and the preferences hold
    the signed-in profile. Android's Auto Backup would copy all of it into the
    user's personal Google account, and adb backup would hand it to anyone with
    debugging access. Both transports are refused outright.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
